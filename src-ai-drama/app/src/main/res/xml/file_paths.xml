<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider路径：成片mp4缓存目录（导出分享用）+ 第六轮本地拍摄/相册上传临时目录 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="clips" path="clips/" />
    <cache-path name="finals" path="." />
    <!-- 第五批 P0：成片落 filesDir/movies（AppGraph.FilmPaths.moviesDir）；
         缺 files-path 时 FileProvider.getUriForFile 会抛 IllegalArgumentException（预览/分享崩溃） -->
    <files-path name="movies" path="movies/" />
    <!-- v1.9.4 在线更新：下载的 APK 落 cacheDir/updates，经 FileProvider 暴露给系统安装器 -->
    <cache-path name="updates" path="updates/" />
    <!-- 第六轮：相机拍摄图片/视频输出目录（TakePicture/TakeVideo 经FileProvider取Uri） -->
    <cache-path name="capture" path="capture/" />
    <!-- 相册/下载等持久媒体（本地上传预览用） -->
    <external-path name="media" path="." />
</paths>
